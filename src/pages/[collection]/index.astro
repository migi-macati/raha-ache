---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionNames, getEverything } from '../../lib/entities';

export async function getStaticPaths() {
  const all = await getEverything();
  return collectionNames.map((collection) => ({
    params: { collection },
    props: {
      collection,
      items: all.filter((entry) => entry.collection === collection).map((entry) => entry.item)
    }
  }));
}

const { collection, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = collection.charAt(0).toUpperCase() + collection.slice(1);
---
<BaseLayout title={title}>
  <header class="page-head">
    <p class="eyebrow">ARCHIVE</p>
    <h1>{title}</h1>
    <p>{items.length} {items.length === 1 ? 'entry' : 'entries'} currently registered.</p>
  </header>

  <div class="grid">
    {items
      .sort((a, b) => a.data.name.localeCompare(b.data.name))
      .map((item) => (
        <a class="card" href={`${base}${collection}/${item.data.id}/`}>
          <span class="eyebrow">{collection.slice(0, -1)}</span>
          <h2>{item.data.name}</h2>
          {item.data.summary && <p>{item.data.summary}</p>}
        </a>
      ))}
  </div>
</BaseLayout>
