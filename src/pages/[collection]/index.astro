---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionNames, getEverything } from '../../lib/entities';

export async function getStaticPaths() {
  const all = await getEverything();
  return collectionNames.map((collection) => ({
    params: { collection },
    props: {
      collection,
      items: all.filter((entry) => entry.collection === collection).map((entry) => entry.item)
    }
  }));
}

const { collection, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = collection.charAt(0).toUpperCase() + collection.slice(1);

const sorted = [...items].sort((a, b) => {
  if (collection === 'chapters') {
    const bookCmp = String(a.data.book).localeCompare(String(b.data.book), undefined, { numeric: true });
    return bookCmp || ((a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0));
  }
  if (collection === 'events') {
    return (a.data.dateSort ?? 99999999) - (b.data.dateSort ?? 99999999);
  }
  if (collection === 'books') {
    return a.data.id.localeCompare(b.data.id, undefined, { numeric: true });
  }
  return a.data.name.localeCompare(b.data.name);
});
---
<BaseLayout title={title}>
  <header class="page-head">
    <h1>{title}</h1>
  </header>

  <div class="plain-list large">
    {sorted.map((item) => (
      <a href={`${base}${collection}/${item.data.id}/`}>{item.data.name}</a>
    ))}
  </div>
</BaseLayout>
