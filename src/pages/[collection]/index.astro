---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionNames, getEverything } from '../../lib/entities';

export async function getStaticPaths() {
  const all = await getEverything();
  return collectionNames.map((collection) => ({
    params: { collection },
    props: {
      collection,
      items: all.filter((entry) => entry.collection === collection).map((entry) => entry.item)
    }
  }));
}

const { collection, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = collection.charAt(0).toUpperCase() + collection.slice(1);

const sorted = [...items].sort((a, b) => {
  if (collection === 'chapters') {
    const bookCmp = String(a.data.book).localeCompare(String(b.data.book), undefined, { numeric: true });
    return bookCmp || ((a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0));
  }
  if (collection === 'events') {
    return (a.data.dateSort ?? 99999999) - (b.data.dateSort ?? 99999999);
  }
  if (collection === 'books') {
    return a.data.id.localeCompare(b.data.id, undefined, { numeric: true });
  }
  return a.data.name.localeCompare(b.data.name);
});

const chapterGroups = collection === 'chapters'
  ? [
      { title: 'Current', items: sorted.filter((item) => item.data.developmentStatus === 'current') },
      { title: 'Working outlines', items: sorted.filter((item) => !item.data.developmentStatus || item.data.developmentStatus === 'working' || item.data.developmentStatus === 'early-outline') },
      { title: 'Superseded', items: sorted.filter((item) => item.data.developmentStatus === 'superseded') }
    ]
  : [];

const characterGroups = collection === 'characters'
  ? [
      { title: 'Current novel canon', items: sorted.filter((item) => item.data.developmentStatus === 'current') },
      { title: 'Working development', items: sorted.filter((item) => item.data.developmentStatus === 'working' || item.data.developmentStatus === 'early-outline') },
      { title: 'Historical and reference figures', items: sorted.filter((item) => !item.data.developmentStatus) },
      { title: 'Superseded', items: sorted.filter((item) => item.data.developmentStatus === 'superseded') }
    ]
  : [];

const grouped = collection === 'chapters' ? chapterGroups : collection === 'characters' ? characterGroups : [];
---
<BaseLayout title={title}>
  <header class="page-head">
    <h1>{title}</h1>
  </header>

  {grouped.length > 0 ? (
    <div>
      {grouped.map((group) => group.items.length > 0 && (
        <section class="index-section">
          <h2>{group.title}</h2>
          <div class="plain-list large">
            {group.items.map((item) => (
              <a href={`${base}${collection}/${item.data.id}/`}>{item.data.name}</a>
            ))}
          </div>
        </section>
      ))}
    </div>
  ) : (
    <div class="plain-list large">
      {sorted.map((item) => (
        <a href={`${base}${collection}/${item.data.id}/`}>{item.data.name}</a>
      ))}
    </div>
  )}
</BaseLayout>
