---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedbackPanel from '../../components/FeedbackPanel.astro';
import { render } from 'astro:content';
import { entityIndex, getEverything, referencedIds } from '../../lib/entities';

export async function getStaticPaths() {
  const all = await getEverything();
  return all.map(({ collection, item }) => ({
    params: { collection, id: item.data.id },
    props: { collection, item, all }
  }));
}

const { collection, item, all } = Astro.props;
const { Content } = await render(item);
const data = item.data;
const index = await entityIndex();

const outgoing = referencedIds(data)
  .map((id) => index.get(id))
  .filter(Boolean);

const relations = Array.isArray(data.relations)
  ? data.relations
      .map((relation) => ({ ...relation, entity: index.get(relation.target) }))
      .filter((relation) => relation.entity)
  : [];

const backlinks = all
  .filter(({ item: candidate }) =>
    candidate.data.id !== data.id &&
    referencedIds(candidate.data).includes(data.id)
  )
  .map(({ collection: candidateCollection, item: candidate }) => ({
    id: candidate.data.id,
    name: candidate.data.name,
    collection: candidateCollection,
    url: `${import.meta.env.BASE_URL}${candidateCollection}/${candidate.data.id}/`
  }));

const label = (value) => String(value ?? '')
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (char) => char.toUpperCase());

const statusBadges = [
  data.status && { value: data.status, text: label(data.status) },
  data.developmentStatus && { value: data.developmentStatus, text: label(data.developmentStatus) },
  collection === 'events' && data.certainty && { value: data.certainty, text: label(data.certainty) }
].filter(Boolean);
---
<BaseLayout title={data.name} description={data.summary}>
  <article class="entity-page">
    <header class="page-head">
      <div class="status-row">
        {statusBadges.map((badge) => (
          <span class={`status-badge status-${badge.value}`}>{badge.text}</span>
        ))}
      </div>
      <h1>{data.name}</h1>
      {collection === 'events' && data.date && <p class="event-date">{data.date}</p>}
      {data.summary && <p>{data.summary}</p>}
    </header>

    {data.aliases?.length > 0 && (
      <p class="meta"><strong>Also known as:</strong> {data.aliases.join(', ')}</p>
    )}

    <div class="prose"><Content /></div>

    {relations.length > 0 && (
      <section class="connections">
        <h2>Relationships</h2>
        <div class="relation-list">
          {relations.map((relation) => (
            <div class="relation-row">
              <span>{relation.type}</span>
              <a href={relation.entity.url}>{relation.entity.name}</a>
              {relation.certainty && <small>{label(relation.certainty)}</small>}
            </div>
          ))}
        </div>
      </section>
    )}

    {outgoing.length > 0 && (
      <section class="connections">
        <h2>Related</h2>
        <div class="link-list">
          {outgoing.map((entity) => (
            <a href={entity.url}>{entity.name}<small>{entity.collection}</small></a>
          ))}
        </div>
      </section>
    )}

    {backlinks.length > 0 && (
      <section class="connections">
        <h2>Referenced by</h2>
        <div class="link-list">
          {backlinks.map((entity) => (
            <a href={entity.url}>{entity.name}<small>{entity.collection}</small></a>
          ))}
        </div>
      </section>
    )}

    <FeedbackPanel collection={collection} id={data.id} title={data.name} />
  </article>
</BaseLayout>
