---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedbackPanel from '../../components/FeedbackPanel.astro';
import ChapterReadAloud from '../../components/ChapterReadAloud.astro';
import { render } from 'astro:content';
import { entityIndex, getEverything, referencedIds } from '../../lib/entities';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const all = await getEverything();
  return all.map(({ collection, item }) => ({
    params: { collection, id: item.data.id },
    props: { collection, item, all }
  }));
}

const { collection, item, all } = Astro.props;
const { Content } = await render(item);
const data = item.data;
const index = await entityIndex();

const outgoing = referencedIds(data).map((id)=>index.get(id)).filter(Boolean);
const relations = Array.isArray(data.relations)
  ? data.relations.map((relation)=>({...relation,entity:index.get(relation.target)})).filter((relation)=>relation.entity)
  : [];

const backlinks = all
  .filter(({ item:candidate })=>candidate.data.id !== data.id && referencedIds(candidate.data).includes(data.id))
  .map(({ collection:candidateCollection,item:candidate })=>({
    id:candidate.data.id,
    name:candidate.data.name,
    collection:candidateCollection,
    url:withBase(`${candidateCollection}/${candidate.data.id}/`)
  }));

const label=(value)=>String(value??'').replaceAll('-',' ').replace(/\b\w/g,(char)=>char.toUpperCase());
const badges=[
  data.status && {value:data.status,text:label(data.status)},
  data.developmentStatus && {value:data.developmentStatus,text:label(data.developmentStatus)},
  collection==='chapters' && data.bonus && {value:'bonus',text:'Bonus'},
  collection==='events' && data.certainty && {value:data.certainty,text:label(data.certainty)},
  collection==='sources' && data.sourceType && {value:data.sourceType,text:label(data.sourceType)}
].filter(Boolean);

const collectionTitle=collection.charAt(0).toUpperCase()+collection.slice(1);
const development=data.developmentStatus==='working' || data.developmentStatus==='early-outline' || data.developmentStatus==='superseded';

const allChapters = collection === 'chapters'
  ? all
      .filter(({ collection: candidateCollection }) => candidateCollection === 'chapters')
      .map(({ item: candidate }) => candidate)
      .sort((a,b) =>
        String(a.data.book).localeCompare(String(b.data.book), undefined, { numeric:true }) ||
        ((a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0))
      )
  : [];

const chapterTrack = collection === 'chapters'
  ? data.developmentStatus === 'superseded'
    ? allChapters.filter((chapter) => chapter.data.developmentStatus === 'superseded')
    : data.bonus
      ? allChapters.filter((chapter) => chapter.data.developmentStatus !== 'superseded' && chapter.data.bonus)
      : allChapters.filter((chapter) => chapter.data.developmentStatus !== 'superseded' && !chapter.data.bonus && chapter.data.book !== 'zz-bonus')
  : [];

const chapterIndex = collection === 'chapters'
  ? chapterTrack.findIndex((chapter) => chapter.data.id === data.id)
  : -1;

const previousChapter = chapterIndex > 0 ? chapterTrack[chapterIndex - 1] : null;
const nextChapter = chapterIndex >= 0 && chapterIndex < chapterTrack.length - 1 ? chapterTrack[chapterIndex + 1] : null;

const chapterGroups = collection === 'chapters'
  ? [
      { key:'book-1', label:'Book I', items:allChapters.filter((chapter)=>chapter.data.book==='book-1' && chapter.data.developmentStatus!=='superseded' && !chapter.data.bonus) },
      { key:'book-2', label:'Book II', items:allChapters.filter((chapter)=>chapter.data.book==='book-2' && chapter.data.developmentStatus!=='superseded' && !chapter.data.bonus) },
      { key:'book-3', label:'Book III', items:allChapters.filter((chapter)=>chapter.data.book==='book-3' && chapter.data.developmentStatus!=='superseded' && !chapter.data.bonus) },
      { key:'book-3-bonus', label:'Book III · Bonus', items:allChapters.filter((chapter)=>chapter.data.book==='book-3' && chapter.data.developmentStatus!=='superseded' && chapter.data.bonus) }
    ].filter((group)=>group.items.length > 0)
  : [];

const chapterStatusLabel=(chapter)=>{
  const status=chapter.data.developmentStatus ?? 'working';
  return status==='current' ? 'Current' : status==='superseded' ? 'Superseded' : 'Working';
};

const bookChapters = collection === 'books'
  ? all
      .filter(({ collection:candidateCollection, item:candidate }) =>
        candidateCollection === 'chapters' &&
        candidate.data.book === data.id &&
        candidate.data.developmentStatus !== 'superseded' &&
        !candidate.data.bonus
      )
      .map(({ item:candidate }) => candidate)
      .sort((a,b)=>(a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0))
  : [];

const bookBonusChapters = collection === 'books'
  ? all
      .filter(({ collection:candidateCollection, item:candidate }) =>
        candidateCollection === 'chapters' &&
        candidate.data.book === data.id &&
        candidate.data.developmentStatus !== 'superseded' &&
        candidate.data.bonus
      )
      .map(({ item:candidate }) => candidate)
      .sort((a,b)=>(a.data.chapterNumber ?? 0) - (b.data.chapterNumber ?? 0))
  : [];
---
<BaseLayout title={data.name} description={data.summary}>
  <nav class="breadcrumbs">
    <a href={withBase()}>Home</a><span>/</span>
    <a href={withBase(`${collection}/`)}>{collectionTitle}</a><span>/</span>
    <span>{data.name}</span>
  </nav>

  <article class="entity-page">
    {development && (
      <aside class="development-notice">
        <strong>Development material</strong>
        <span>This page is retained for writing and revision and may not represent current novel canon.</span>
      </aside>
    )}

    <header class="page-head entity-head">
      <div class="status-row">
        {badges.map((badge)=><span class={`status-badge status-${badge.value}`}>{badge.text}</span>)}
      </div>
      <h1>{data.name}</h1>
      {collection==='events' && data.date && <p class="event-date">{data.date}</p>}
      {collection==='sources' && (data.year || data.citation) && (
        <div class="source-meta">
          {data.year && <p><strong>Date:</strong> {data.year}</p>}
          {data.citation && <p><strong>Citation:</strong> {data.citation}</p>}
        </div>
      )}
      {data.summary && <p class="entity-summary">{data.summary}</p>}
    </header>

    {collection === 'chapters' && (
      <nav class="chapter-nav" aria-label="Chapter navigation">
        <div class="chapter-step">
          {previousChapter ? (
            <a href={withBase(`chapters/${previousChapter.data.id}/`)} aria-label={`Previous chapter: ${previousChapter.data.name}`}>
              <small>Previous</small>
              <strong>{previousChapter.data.name.replace(/^Book [IVX]+, (?:Bonus )?Chapter \d+:\s*/, '').replace(/^Bonus Chapter:\s*/, '')}</strong>
            </a>
          ) : (
            <span class="chapter-step-disabled"><small>Previous</small><strong>Start of this track</strong></span>
          )}
        </div>

        <div class="chapter-jump">
          <label for="chapter-select">All chapters</label>
          <select id="chapter-select">
            {chapterGroups.map((group)=>(
              <optgroup label={group.label}>
                {group.items.map((chapter)=>(
                  <option value={withBase(`chapters/${chapter.data.id}/`)} selected={chapter.data.id===data.id}>
                    {chapter.data.chapterNumber}. {chapter.data.name.replace(/^Book [IVX]+, (?:Bonus )?Chapter \d+:\s*/, '').replace(/^Bonus Chapter:\s*/, '')} · {chapterStatusLabel(chapter)}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <div class="chapter-step next">
          {nextChapter ? (
            <a href={withBase(`chapters/${nextChapter.data.id}/`)} aria-label={`Next chapter: ${nextChapter.data.name}`}>
              <small>Next</small>
              <strong>{nextChapter.data.name.replace(/^Book [IVX]+, (?:Bonus )?Chapter \d+:\s*/, '').replace(/^Bonus Chapter:\s*/, '')}</strong>
            </a>
          ) : (
            <span class="chapter-step-disabled"><small>Next</small><strong>End of this track</strong></span>
          )}
        </div>
      </nav>
    )}

    {data.aliases?.length > 0 && <p class="meta aliases"><strong>Also known as</strong> {data.aliases.join(' · ')}</p>}

    {collection === 'chapters' && <ChapterReadAloud />}
    <div class="prose" data-chapter-prose={collection === 'chapters' ? '' : undefined}><Content /></div>

    {collection === 'books' && bookChapters.length > 0 && (
      <section class="connections">
        <h2>Chapters</h2>
        <div class="connection-grid">
          {bookChapters.map((chapter)=>(
            <a class="connection-card" href={withBase(`chapters/${chapter.data.id}/`)}>
              <small>{chapter.data.draftStatus} · {chapterStatusLabel(chapter)}</small>
              <strong>{chapter.data.name}</strong>
            </a>
          ))}
        </div>
      </section>
    )}

    {collection === 'books' && bookBonusChapters.length > 0 && (
      <section class="connections">
        <h2>Bonus chapters</h2>
        <div class="connection-grid">
          {bookBonusChapters.map((chapter)=>(
            <a class="connection-card" href={withBase(`chapters/${chapter.data.id}/`)}>
              <small>bonus · {chapter.data.draftStatus}</small>
              <strong>{chapter.data.name}</strong>
            </a>
          ))}
        </div>
      </section>
    )}

    {collection === 'chapters' && (
      <nav class="chapter-nav chapter-nav-bottom" aria-label="Chapter navigation">
        <div class="chapter-step">
          {previousChapter ? (
            <a href={withBase(`chapters/${previousChapter.data.id}/`)}>
              <small>Previous</small>
              <strong>{previousChapter.data.name.replace(/^Book [IVX]+, (?:Bonus )?Chapter \d+:\s*/, '').replace(/^Bonus Chapter:\s*/, '')}</strong>
            </a>
          ) : (
            <span class="chapter-step-disabled"><small>Previous</small><strong>Start of this track</strong></span>
          )}
        </div>
        <a class="chapter-all-link" href={withBase('chapters/')}>All chapters</a>
        <div class="chapter-step next">
          {nextChapter ? (
            <a href={withBase(`chapters/${nextChapter.data.id}/`)}>
              <small>Next</small>
              <strong>{nextChapter.data.name.replace(/^Book [IVX]+, (?:Bonus )?Chapter \d+:\s*/, '').replace(/^Bonus Chapter:\s*/, '')}</strong>
            </a>
          ) : (
            <span class="chapter-step-disabled"><small>Next</small><strong>End of this track</strong></span>
          )}
        </div>
      </nav>
    )}

    {collection === 'chapters' && (
      <script is:inline>
        const select=document.getElementById('chapter-select');
        if(select){
          select.addEventListener('change',()=>{ if(select.value) window.location.href=select.value; });
        }
      </script>
    )}

    {relations.length > 0 && (
      <section class="connections">
        <h2>Relationships</h2>
        <div class="relation-list">
          {relations.map((relation)=>(
            <a class="relation-row" href={relation.entity.url}>
              <span>{relation.type}</span><strong>{relation.entity.name}</strong>
              {relation.certainty && <small>{label(relation.certainty)}</small>}
            </a>
          ))}
        </div>
      </section>
    )}

    {outgoing.length > 0 && (
      <section class="connections">
        <h2>Related</h2>
        <div class="connection-grid">
          {outgoing.map((entity)=>(
            <a class="connection-card" href={entity.url}><small>{entity.collection}</small><strong>{entity.name}</strong></a>
          ))}
        </div>
      </section>
    )}

    {backlinks.length > 0 && (
      <section class="connections">
        <h2>Referenced by</h2>
        <div class="connection-grid">
          {backlinks.map((entity)=>(
            <a class="connection-card" href={entity.url}><small>{entity.collection}</small><strong>{entity.name}</strong></a>
          ))}
        </div>
      </section>
    )}

    <FeedbackPanel collection={collection} id={data.id} title={data.name} />
  </article>
</BaseLayout>
