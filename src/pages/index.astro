---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const [characters, places, events, sources, books, chapters] = await Promise.all([
  getCollection('characters'),
  getCollection('places'),
  getCollection('events'),
  getCollection('sources'),
  getCollection('books'),
  getCollection('chapters')
]);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Story Bible">
  <section class="hero">
    <p class="eyebrow">THE PUBLIC STORY BIBLE</p>
    <h1>Raha Ache</h1>
    <p class="lede">A living archive for the trilogy: people, places, events, sources, timelines, books, and chapters joined into one navigable world.</p>
    <div class="actions">
      <a class="button" href={`${base}timeline/`}>Enter the timeline</a>
      <a class="button ghost" href={`${base}books/`}>Open the trilogy</a>
    </div>
  </section>

  <section class="stats" aria-label="Archive counts">
    <div><strong>{characters.length}</strong><span>Characters</span></div>
    <div><strong>{places.length}</strong><span>Places</span></div>
    <div><strong>{events.length}</strong><span>Events</span></div>
    <div><strong>{sources.length}</strong><span>Sources</span></div>
    <div><strong>{books.length}</strong><span>Books</span></div>
    <div><strong>{chapters.length}</strong><span>Chapters</span></div>
  </section>

  <section class="principle">
    <p class="eyebrow">ONE WORLD, ONE SET OF ENTITIES</p>
    <h2>Every important name resolves to its own page.</h2>
    <p>Ache, Maynila, an event, a source, a book, or a chapter has one canonical identity. Mentions in archive prose are automatically linked, while every entity page gathers the records that point back to it.</p>
  </section>
</BaseLayout>
