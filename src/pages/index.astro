---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const [characters, places, events, objects, technologies, practices, ideas, sources, books, chapters, research] = await Promise.all([
  getCollection('characters'),
  getCollection('places'),
  getCollection('events'),
  getCollection('objects'),
  getCollection('technologies'),
  getCollection('practices'),
  getCollection('ideas'),
  getCollection('sources'),
  getCollection('books'),
  getCollection('chapters'),
  getCollection('research')
]);

const currentBooks = [...books]
  .filter((item) => item.data.developmentStatus === 'current')
  .sort((a,b)=>a.data.id.localeCompare(b.data.id,undefined,{numeric:true}));

const bookKickers = {
  'book-1': 'Flight · survival · first companions',
  'book-2': 'Training · campaigns · command',
  'book-3': 'Return · state-building · legacy'
};

const universeCards = [
  { label:'Characters', count:characters.length, path:'characters/', note:'Rulers, allies, rivals and family' },
  { label:'Places', count:places.length, path:'places/', note:'Maynila, Brunei and the maritime world' },
  { label:'Timeline', count:events.length, path:'timeline/', note:'Follow the story world chronologically' },
  { label:'Events', count:events.length, path:'events/', note:'Historical events and reconstructed sequence' },
  { label:'Objects', count:objects.length, path:'objects/', note:'Goods, weapons, vessels and material culture' },
  { label:'Technology', count:technologies.length, path:'technologies/', note:'Maritime, military and craft technologies' },
  { label:'Practices', count:practices.length, path:'practices/', note:'Customs, rituals, trade and political practice' },
  { label:'Ideas', count:ideas.length, path:'ideas/', note:'Beliefs, concepts and values shaping the story' }
];

const studioCards = [
  { label:'Chapters', count:chapters.length, path:'chapters/', note:'Current, working and superseded chapter material' },
  { label:'Research', count:research.length, path:'research/', note:'Canon decisions, questions and development' },
  { label:'Sources', count:sources.length, path:'sources/', note:'Primary records and scholarship' },
  { label:'Feedback', count:null, path:'feedback/', note:'Corrections and revision queue' }
];
---
<BaseLayout title="Raha Ache">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Historical web novel · Maritime epic</p>
      <h1>Raha Ache</h1>
      <p class="hero-deck">A young prince loses Maynila, crosses the seas, learns command, and returns to build a kingdom that history will not leave untouched.</p>
      <div class="hero-actions">
        <a class="button primary" href={withBase('novel/')}>Enter the novel</a>
        <a class="button" href={withBase('universe/')}>Explore the universe</a>
      </div>
    </div>

    <form class="hero-search" action={withBase('search/')} method="get">
      <label for="home-search">Search the story world</label>
      <div class="search-field">
        <input id="home-search" name="q" type="search" placeholder="Ache, Brunei, 1521, Pigafetta…" />
        <button type="submit">Search</button>
      </div>
    </form>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The trilogy</p>
        <h2>Follow Ache’s journey</h2>
      </div>
      <a class="section-link" href={withBase('novel/')}>Novel view</a>
    </div>

    <div class="book-grid">
      {currentBooks.map((book, index) => (
        <a class="book-card" href={withBase(`books/${book.data.id}/`)}>
          <span class="book-number">0{index + 1}</span>
          <h3>{book.data.name.replace(/^Book [IVX]+:\s*/, '')}</h3>
          <p>{bookKickers[book.data.id] ?? 'Current trilogy'}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Public universe</p>
        <h2>Explore the world</h2>
      </div>
      <a class="section-link" href={withBase('universe/')}>Universe view</a>
    </div>

    <div class="explore-grid">
      {universeCards.map((item) => (
        <a class="explore-card" href={withBase(item.path)}>
          <div><h3>{item.label}</h3><p>{item.note}</p></div>
          <span>{item.count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section studio-preview">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Writing workspace</p>
        <h2>Studio</h2>
      </div>
      <a class="section-link" href={withBase('studio/')}>Open studio</a>
    </div>

    <div class="studio-mini-grid">
      {studioCards.map((item) => (
        <a href={withBase(item.path)}>
          <strong>{item.label}</strong>
          <span>{item.note}</span>
          {item.count !== null && <small>{item.count}</small>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
