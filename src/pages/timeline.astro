---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events'))
  .sort((a, b) => (a.data.dateSort ?? 99999999) - (b.data.dateSort ?? 99999999));
const base = import.meta.env.BASE_URL;
const label = (value) => String(value ?? '')
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (char) => char.toUpperCase());
---
<BaseLayout title="Timeline">
  <header class="page-head">
    <h1>Timeline</h1>
    <div class="timeline-key" aria-label="Evidence key">
      <span class="status-badge status-documented">Documented</span>
      <span class="status-badge status-strong-inference">Strong inference</span>
      <span class="status-badge status-possible">Possible</span>
      <span class="status-badge status-novel-canon">Novel canon</span>
      <span class="status-badge status-fiction">Fiction</span>
    </div>
  </header>

  <div class="timeline">
    {events.map((event) => (
      <article>
        <time>{event.data.date ?? 'Date unresolved'}</time>
        <div>
          {event.data.certainty && (
            <span class={`status-badge status-${event.data.certainty}`}>{label(event.data.certainty)}</span>
          )}
          <h2><a href={`${base}events/${event.data.id}/`}>{event.data.name}</a></h2>
          {event.data.summary && <p>{event.data.summary}</p>}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
