---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events'))
  .sort((a, b) => (a.data.dateSort ?? 99999999) - (b.data.dateSort ?? 99999999));
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Timeline">
  <header class="page-head">
    <p class="eyebrow">CHRONOLOGY</p>
    <h1>Timeline</h1>
    <p>The timeline can hold documented history, inference, novel canon, and fiction without collapsing them into one category.</p>
  </header>

  <div class="timeline">
    {events.map((event) => (
      <article>
        <time>{event.data.date ?? 'Date unresolved'}</time>
        <div>
          <span class="badge">{event.data.certainty ?? 'uncategorized'}</span>
          <h2><a href={`${base}events/${event.data.id}/`}>{event.data.name}</a></h2>
          {event.data.summary && <p>{event.data.summary}</p>}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
