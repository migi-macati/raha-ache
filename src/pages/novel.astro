---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const books = (await getCollection('books'))
  .filter((item)=>item.data.developmentStatus === 'current')
  .sort((a,b)=>a.data.id.localeCompare(b.data.id,undefined,{numeric:true}));

const chapters = await getCollection('chapters');
const activeChapters = chapters
  .filter((item)=>item.data.developmentStatus !== 'superseded' && item.data.book !== 'zz-bonus' && !item.data.bonus)
  .sort((a,b)=>String(a.data.book).localeCompare(String(b.data.book),undefined,{numeric:true}) || a.data.chapterNumber-b.data.chapterNumber);

const bonusChapters = chapters
  .filter((item)=>item.data.developmentStatus !== 'superseded' && item.data.bonus)
  .sort((a,b)=>a.data.chapterNumber-b.data.chapterNumber);

const firstChapter = activeChapters[0];
---
<BaseLayout title="Novel">
  <nav class="breadcrumbs"><a href={withBase()}>Home</a><span>/</span><span>Novel</span></nav>

  <header class="page-head compact">
    <p class="eyebrow">Read</p>
    <h1>The novel</h1>
    <p>The active trilogy and chapter sequence, from Book I onward.</p>
  </header>

  {firstChapter && (
    <p><a class="button primary" href={withBase(`chapters/${firstChapter.data.id}/`)}>Start at Chapter 1</a></p>
  )}

  <section class="novel-books">
    {books.map((book,index)=>(
      <a class="novel-book-row" href={withBase(`books/${book.data.id}/`)}>
        <span>0{index+1}</span>
        <div><strong>{book.data.name.replace(/^Book [IVX]+:\s*/, '')}</strong><small>{book.data.developmentStatus}</small></div>
      </a>
    ))}
  </section>

  {books.map((book)=> {
    const bookChapters = activeChapters.filter((chapter)=>chapter.data.book === book.data.id);
    const bookBonus = bonusChapters.filter((chapter)=>chapter.data.book === book.data.id);
    return (
      <>
        {bookChapters.length > 0 && (
          <section class="directory-section">
            <div class="directory-section-head">
              <h2>{book.data.name}</h2>
              <span>{bookChapters.length}</span>
            </div>
            <div class="directory-grid">
              {bookChapters.map((chapter)=>(
                <a class="directory-card" href={withBase(`chapters/${chapter.data.id}/`)}>
                  <strong>{chapter.data.name}</strong>
                  <small>{chapter.data.draftStatus} · {chapter.data.developmentStatus ?? 'working'}</small>
                </a>
              ))}
            </div>
          </section>
        )}
        {bookBonus.length > 0 && (
          <section class="directory-section">
            <div class="directory-section-head">
              <h2>{book.data.name} · Bonus</h2>
              <span>{bookBonus.length}</span>
            </div>
            <div class="directory-grid">
              {bookBonus.map((chapter)=>(
                <a class="directory-card" href={withBase(`chapters/${chapter.data.id}/`)}>
                  <strong>{chapter.data.name}</strong>
                  <small>bonus · {chapter.data.draftStatus}</small>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    );
  })}
</BaseLayout>
