---
import '../styles/global.css';
import { withBase } from '../lib/base';
const {
  title = 'Raha Ache',
  description = 'Raha Ache'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Raha Ache</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase()}>RAHA ACHE</a>
      <nav aria-label="Primary">
        <a href={withBase('timeline/')}>Timeline</a>
        <a href={withBase('characters/')}>Characters</a>
        <a href={withBase('places/')}>Places</a>
        <a href={withBase('events/')}>Events</a>
        <a href={withBase('sources/')}>Sources</a>
        <a href={withBase('books/')}>Books</a>
        <a href={withBase('chapters/')}>Chapters</a>
        <a href={withBase('research/')}>Research</a>
        <a href={withBase('feedback/')}>Feedback</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Raha Ache</footer>
  </body>
</html>
