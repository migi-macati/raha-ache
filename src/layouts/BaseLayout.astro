---
import '../styles/global.css';
const {
  title = 'Raha Ache',
  description = 'Raha Ache archive.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Raha Ache</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>RAHA ACHE</a>
      <nav aria-label="Primary">
        <a href={`${base}timeline/`}>Timeline</a>
        <a href={`${base}characters/`}>Characters</a>
        <a href={`${base}places/`}>Places</a>
        <a href={`${base}events/`}>Events</a>
        <a href={`${base}sources/`}>Sources</a>
        <a href={`${base}books/`}>Books</a>
        <a href={`${base}chapters/`}>Chapters</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Raha Ache</footer>
  </body>
</html>
