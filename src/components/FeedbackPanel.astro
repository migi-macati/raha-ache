---
import { withBase } from '../lib/base';

interface Props {
  collection: string;
  id: string;
  title: string;
}

const { collection, id, title } = Astro.props;
const repoUrl = 'https://github.com/migi-macati/raha-ache';
const key = `${collection}/${id}`;
const pageUrl = new URL(withBase(`${collection}/${id}/`), Astro.site).toString();
const issueTitle = `[Feedback: ${key}] ${title}`;
const issueBody = [
  `Page: ${pageUrl}`,
  `Page key: ${key}`,
  '',
  'Feedback / correction:',
  '',
  '',
  'Reason or source (optional):',
  ''
].join('\n');

const addUrl = `${repoUrl}/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
const contributionTitle = `[Contribution: ${key}] ${title}`;
const contributionUrl = `${repoUrl}/issues/new?template=story-contribution.yml&title=${encodeURIComponent(contributionTitle)}`;
const openQuery = `is:issue is:open in:title "${key}"`;
const closedQuery = `is:issue is:closed in:title "${key}"`;
const openUrl = `${repoUrl}/issues?q=${encodeURIComponent(openQuery)}`;
const archiveUrl = `${repoUrl}/issues?q=${encodeURIComponent(closedQuery)}`;
---
<section class="feedback-panel" aria-labelledby="feedback-heading">
  <div>
    <h2 id="feedback-heading">Discuss this page</h2>
    <p>Comment, correct, add a source, or propose material. Replies stay in the thread; resolved items stay archived.</p>
  </div>
  <div class="feedback-actions">
    <a class="feedback-primary" href={addUrl} target="_blank" rel="noreferrer">Comment / correct</a>
    <a href={contributionUrl} target="_blank" rel="noreferrer">Propose contribution</a>
    <a href={openUrl} target="_blank" rel="noreferrer">Open threads</a>
    <a href={archiveUrl} target="_blank" rel="noreferrer">Archive</a>
  </div>
</section>
