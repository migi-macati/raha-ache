<section class="read-aloud" aria-label="Chapter audio reader" data-read-aloud>
  <div class="read-aloud-heading"><strong>Listen to this chapter</strong><span data-speech-status role="status" aria-live="polite">Ready</span></div>
  <div class="read-aloud-controls">
    <button type="button" data-speech-play>Play</button>
    <button type="button" data-speech-stop>Stop</button>
    <label>Speed <select data-speech-rate><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label>
    <label>Voice <select data-speech-voice aria-label="Narrator voice"><option value="">Device default</option></select></label>
  </div>
  <p class="read-aloud-note">Uses your device's available voices. Playback may stop when you leave this page or lock your screen.</p>
</section>
<style>
.read-aloud{border:1px solid var(--border, #aaa);border-radius:12px;padding:1rem;margin:1.25rem 0;background:var(--surface,transparent)}
.read-aloud-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap}
.read-aloud-heading span,.read-aloud-note{font-size:.85rem;opacity:.8}
.read-aloud-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem;margin-top:.75rem}
.read-aloud-controls button,.read-aloud-controls select{font:inherit;border:1px solid currentColor;border-radius:7px;padding:.4rem .65rem;background:transparent;color:inherit}
.read-aloud-controls label{display:flex;align-items:center;gap:.4rem;font-size:.9rem}
.read-aloud-controls :focus-visible{outline:3px solid #d2a83e;outline-offset:3px}
.read-aloud-note{margin:.75rem 0 0}
.prose .speech-active{background:rgba(224,183,70,.2);border-radius:3px}
</style>
<script is:inline>
function initializeChapterReadAloud() {
  const panel=document.querySelector('[data-read-aloud]');
  const prose=document.querySelector('[data-chapter-prose]');
  if(!panel||!prose)return;
  const play=panel.querySelector('[data-speech-play]');
  const stop=panel.querySelector('[data-speech-stop]');
  const rate=panel.querySelector('[data-speech-rate]');
  const voiceSelect=panel.querySelector('[data-speech-voice]');
  const status=panel.querySelector('[data-speech-status]');
  const supported=('speechSynthesis' in window)&&('SpeechSynthesisUtterance' in window);
  if(!supported){play.disabled=true;stop.disabled=true;rate.disabled=true;voiceSelect.disabled=true;status.textContent='Read aloud is unavailable in this browser';return;}
  const synth=window.speechSynthesis;
  const blocks=[...prose.querySelectorAll('p,blockquote,li,h2,h3')].filter(el=>el.textContent.trim());
  let index=0,active=false,session=0,utterance=null,selectedVoice='';
  const clearHighlight=()=>prose.querySelectorAll('.speech-active').forEach(el=>el.classList.remove('speech-active'));
  const setStatus=(value)=>{status.textContent=value;};
  const reset=()=>{session++;active=false;utterance=null;synth.cancel();clearHighlight();play.textContent='Play';setStatus('Stopped');};
  const voices=()=>{const available=synth.getVoices();const prior=voiceSelect.value;voiceSelect.replaceChildren(new Option('Device default',''));available.forEach(v=>voiceSelect.add(new Option(v.name+' ('+v.lang+')',v.voiceURI)));voiceSelect.value=available.some(v=>v.voiceURI===prior)?prior:'';};
  voices();synth.addEventListener?.('voiceschanged',voices);
  const speak=()=>{
    if(!active)return;
    if(index>=blocks.length){reset();setStatus('Finished');return;}
    clearHighlight();const block=blocks[index];block.classList.add('speech-active');
    const u=new SpeechSynthesisUtterance(block.textContent.trim());utterance=u;
    u.rate=Number(rate.value);const found=synth.getVoices().find(v=>v.voiceURI===voiceSelect.value);if(found)u.voice=found;
    const token=session;
    u.onend=()=>{if(!active||token!==session)return;index++;speak();};
    u.onerror=(event)=>{if(token!==session||!active)return;if(event.error==='interrupted'||event.error==='canceled')return;reset();setStatus('Playback error. Try again.');};
    setStatus('Reading paragraph '+(index+1)+' of '+blocks.length);
    try{synth.speak(u);}catch{reset();setStatus('Unable to start narration');}
  };
  play.addEventListener('click',()=>{
    if(active&&synth.paused){synth.resume();play.textContent='Pause';setStatus('Reading');return;}
    if(active){synth.pause();play.textContent='Resume';setStatus('Paused');return;}
    synth.cancel();session++;index=0;active=true;play.textContent='Pause';speak();
  });
  stop.addEventListener('click',reset);
  rate.addEventListener('change',()=>{if(active){session++;synth.cancel();speak();}});
  voiceSelect.addEventListener('change',()=>{if(active){session++;synth.cancel();speak();}});
  window.addEventListener('pagehide',reset,{once:true});
}
if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded',initializeChapterReadAloud,{once:true});
}else{
  initializeChapterReadAloud();
}
</script>
